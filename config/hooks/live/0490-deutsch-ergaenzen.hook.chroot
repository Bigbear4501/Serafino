T["print-manager"] = dict(_pm, **{
 "@item\x04Manual Config": "Manuelle Einrichtung",
 "NOTE: This application is deprecated and will be removed from Plasma in a future release.": "HINWEIS: Diese Anwendung ist veraltet und wird in einer künftigen Version aus Plasma entfernt.",
 "The expected input should be printer/deviceid": "Erwartet wird die Eingabe Drucker/Geräte-ID",
})

import os, struct, sys
ROOT = os.environ.get("SERAFINO_ROOT", "")
LOC = ROOT + "/usr/share/locale/de/LC_MESSAGES"

def lesen(pfad):
    d = open(pfad, "rb").read()
    mg = struct.unpack("<I", d[:4])[0]
    e = "<" if mg == 0x950412de else ">"
    _, _, n, oo, to = struct.unpack(e + "IIIII", d[4:24])[0:5] if False else (None,) + struct.unpack(e + "IIII", d[4:20])
    eintr = {}
    for i in range(n):
        l, o = struct.unpack(e + "II", d[oo + 8*i: oo + 8*i + 8])
        k = d[o:o+l]
        l2, o2 = struct.unpack(e + "II", d[to + 8*i: to + 8*i + 8])
        eintr[k] = d[o2:o2+l2]
    return eintr

def schreiben(pfad, eintr):
    ks = sorted(eintr)
    ids = b""; strs = b""; off = []
    for k in ks:
        v = eintr[k]
        off.append((len(ids), len(k), len(strs), len(v)))
        ids += k + b"\0"; strs += v + b"\0"
    n = len(ks); ko = 28 + 16*n; vo = ko + len(ids)
    out = struct.pack("<7I", 0x950412de, 0, n, 28, 28 + 8*n, 0, 0)
    for o, l, _, _ in off: out += struct.pack("<II", l, ko + o)
    for _, _, o, l in off: out += struct.pack("<II", l, vo + o)
    tmp = pfad + ".neu"
    open(tmp, "wb").write(out + ids + strs)
    os.replace(tmp, pfad)

for dom, tr in T.items():
    p = LOC + "/" + dom + ".mo"
    if not os.path.exists(p):
        print("serafino-de: %s fehlt, uebersprungen" % p); continue
    e = lesen(p)
    neu = 0
    for k, v in tr.items():
        kb = k.encode("utf-8")
        if not e.get(kb):
            e[kb] = v.encode("utf-8"); neu += 1
    if neu:
        if not os.path.exists(p + ".orig"):
            open(p + ".orig", "wb").write(open(p, "rb").read())
        schreiben(p, e)
    print("serafino-de: %s: %d Texte ergaenzt" % (dom, neu))
SERAFINO_PY_EOF
python3 /usr/share/serafino/de-ergaenzen.py

# Polkit-Text der Firewall (ufw): fehlende deutsche Zeilen ergaenzen
python3 - <<'POLKIT_EOF'
import os
p = os.environ.get("SERAFINO_ROOT", "") + "/usr/share/polkit-1/actions/org.kde.ufw.policy"
if os.path.exists(p):
    s = open(p, encoding="utf-8").read()
    paare = [
        ("      <description>Query Applications</description>\n",
         '      <description xml:lang="de">Anwendungen abfragen</description>\n'),
        ("      <message>Query the automatic application block list</message>\n",
         '      <message xml:lang="de">Die automatische Sperrliste für Anwendungen abfragen</message>\n'),
    ]
    for alt, neu in paare:
        if s.count(alt) == 1 and neu not in s:
            s = s.replace(alt, alt + neu)
            print("serafino-de: polkit ergaenzt:", neu.strip())
    open(p, "w", encoding="utf-8").write(s)
else:
    print("serafino-de: ufw.policy fehlt, uebersprungen")
POLKIT_EOF
exit 0
