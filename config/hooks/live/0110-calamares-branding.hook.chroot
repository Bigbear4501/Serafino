#!/bin/bash
# 0110-calamares-branding.hook.chroot
#
# Läuft chrooted, NACH der Paketinstallation (Calamares muss also schon
# installiert sein, damit /etc/calamares/ existiert).
# Baut ein eigenes Serafino-Branding-Theme für Calamares und aktiviert es.

set -e

if [ ! -d /etc/calamares ]; then
    echo "Calamares scheint nicht installiert zu sein, überspringe Branding." >&2
    exit 0
fi

echo "Baue Serafino-Branding für Calamares..."

mkdir -p /etc/calamares/branding/serafino

# Logo und Willkommensbild mit Fino (liegen im Serafino-Paket)
cp /usr/share/serafino/calamares/logo.png /etc/calamares/branding/serafino/logo.png
cp /usr/share/serafino/calamares/welcome.png /etc/calamares/branding/serafino/welcome.png




# branding.desc schreiben
cat > /etc/calamares/branding/serafino/branding.desc << 'BRANDEOF'
---
componentName: serafino

welcomeStyleCalamares: false
welcomeExpandingLogo:  false

strings:
    productName:         "Serafino"
    shortProductName:    "Serafino"
    version:              ""
    shortVersion:         ""
    versionedName:        "Serafino"
    shortVersionedName:   "Serafino"
    bootloaderEntryName:  "Serafino"
    productUrl:           "https://github.com/Bigbear4501/Serafino"
    supportUrl:           ""
    knownIssuesUrl:       ""
    releaseNotesUrl:      ""
    donateUrl:            ""

images:
    productLogo:          "logo.png"
    productIcon:           "logo.png"
    productWelcome:        "welcome.png"

slideshow: "show.qml"

style:
   sidebarBackground:         "#ffffff"
   sidebarText:               "#2b2b2b"
   sidebarTextSelect:         "#2e8b57"
   sidebarTextCurrent:        "#2b2b2b"
   sidebarBackgroundCurrent:  "#f0f0f0"
   sidebarBackgroundSelected: "#dcdcdc"
BRANDEOF

# Slideshow mit Willkommensbild + eigenem Begrüßungstext
cat > /etc/calamares/branding/serafino/show.qml << 'QMLEOF'
import QtQuick 2.0
import calamares.slideshow 1.0

Presentation {
    id: presentation

    Slide {
        Image {
            id: background
            source: "welcome.png"
            anchors.fill: parent
            fillMode: Image.PreserveAspectCrop
            clip: true
        }
    }

    function nextSlide() {
        presentation.goToNextSlide();
    }

    Timer {
        interval: 5000
        running: true
        repeat: true
        onTriggered: presentation.nextSlide()
    }
}
QMLEOF

# Aktivieren: settings.conf auf unser Branding umstellen
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: serafino/' /etc/calamares/settings.conf
    echo "Branding in settings.conf aktiviert."
else
    echo "WARNUNG: /etc/calamares/settings.conf nicht gefunden, Branding evtl. nicht aktiv." >&2
fi

echo "Serafino-Calamares-Branding fertig eingerichtet."

# Das von calamares-settings-debian automatisch mitgelieferte
# Desktop-Icon entfernen, damit nur unser eigenes (mit Branding,
# passwortlosem sudo und Trust-Markierung) übrig bleibt.
rm -f /etc/skel/Desktop/install-debian.desktop
rm -f /usr/share/applications/calamares.desktop 2>/dev/null || true
echo "Automatisches Debian-Installer-Icon entfernt."
