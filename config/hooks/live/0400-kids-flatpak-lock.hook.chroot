#!/bin/bash
# 0400-kids-flatpak-lock.hook.chroot
# Kinder dürfen keine Flatpaks selbst installieren (flatpak --user).
set -e
mkdir -p /var/lib/serafino/birth /var/lib/serafino/profiles
systemctl enable serafino-kids-flatpak-lock.service serafino-kids-flatpak-lock.path
echo "Flatpak-Sperre für Kinder aktiviert."
