#!/bin/bash
# 0410-kids-noexec.hook.chroot
# Kinder können keine selbst heruntergeladenen Programme starten (noexec).
set -e
mkdir -p /var/lib/serafino/birth /var/lib/serafino/profiles
systemctl enable serafino-kids-noexec.service serafino-kids-noexec.path
echo "noexec für Kinder-Ordner aktiviert."
