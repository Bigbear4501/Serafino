#!/bin/bash
# 0420-media-access.hook.chroot
# Kamera und Mikrofon erst ab 10 Jahren.
set -e
getent group serafinomedia >/dev/null || groupadd --system serafinomedia
mkdir -p /var/lib/serafino/birth /var/lib/serafino/profiles
systemctl enable serafino-media-access.service serafino-media-access.path serafino-media-access.timer
echo "Kamera und Mikrofon erst ab 10 aktiviert."
