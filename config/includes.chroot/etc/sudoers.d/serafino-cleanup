# Erlaubt das automatische Entfernen der Installer-Verknüpfungen
# auf einem installierten System, ohne Passwort-Abfrage.
Cmnd_Alias SERAFINO_CLEANUP = /bin/rm -f /usr/share/applications/serafino-installer.desktop, /bin/rm -f /usr/share/serafino/install-serafino.desktop, /bin/rm -f /usr/share/applications/calamares.desktop, /bin/rm -f /usr/share/applications/org.calamares.calamares.desktop
%sudo ALL=(ALL) NOPASSWD: SERAFINO_CLEANUP
