// Pingulinux / Serafino: Standard-Einstellungen für fastfetch (für alle Konten).
// Eigene Einstellungen eines Kontos (~/.config/fastfetch/config.jsonc) haben Vorrang.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/pingulinux/fastfetch/fino.txt",
    "color": {
      "1": "bright_yellow",
      "2": "bright_blue",
      "3": "38;5;214",
      "4": "bright_white",
      "5": "bright_cyan"
    },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "bright_cyan", "title": "bright_yellow", "output": "default" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "System    " },
    { "type": "host",     "key": "Gerät     " },
    { "type": "kernel",   "key": "Kernel    " },
    { "type": "uptime",   "key": "Läuft seit" },
    { "type": "packages", "key": "Pakete    " },
    { "type": "de",       "key": "Oberfläche" },
    { "type": "display",  "key": "Bildschirm" },
    { "type": "cpu",      "key": "Prozessor " },
    { "type": "gpu",      "key": "Grafik    " },
    { "type": "memory",   "key": "Speicher  " },
    { "type": "disk",     "key": "Festplatte", "folders": "/" },
    { "type": "battery",  "key": "Akku      " },
    { "type": "locale",   "key": "Sprache   " },
    "break",
    "colors"
  ]
}
