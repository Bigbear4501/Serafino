[Unit]
Description=Serafino: Fino als Profilbild für Konten ohne eigenes Bild
After=accounts-daemon.service local-fs.target
Wants=accounts-daemon.service
Before=display-manager.service sddm.service
ConditionKernelCommandLine=!boot=live

[Service]
Type=oneshot
ExecStart=/usr/local/bin/serafino-standard-profilbild.sh

[Install]
WantedBy=multi-user.target
