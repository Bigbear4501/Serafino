// pingulinux.script
// Einfaches Plymouth-Script-Theme: zentriertes Logo + Ladebalken

Window.SetBackgroundTopColor(1, 1, 1);
Window.SetBackgroundBottomColor(0.95, 0.95, 0.95);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);

logo_width = logo.image.GetWidth();
logo_height = logo.image.GetHeight();

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo.x = screen_width / 2 - logo_width / 2;
logo.y = screen_height / 2 - logo_height / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10000);
logo.sprite.SetOpacity(0);

// Ladebalken (einfacher Rahmen + Füllbalken)
bar_width = 300;
bar_height = 18;
bar.x = screen_width / 2 - bar_width / 2;
bar.y = logo.y + logo_height + 40;

bar_bg.image = Image.Text("", 1, 1, 1);
bar_frame_color = 0.7;

fun_progress_callback = function(duration, progress) {
    // Logo sanft einblenden in den ersten ~30% der Bootzeit
    fade_in_progress = progress * 3;
    if (fade_in_progress > 1) fade_in_progress = 1;
    logo.sprite.SetOpacity(fade_in_progress);

    // Ladebalken zeichnen: Hintergrund
    bar.bg_sprite.SetPosition(bar.x, bar.y, 10);
    bar.bg_sprite.SetX(bar.x);

    // Fortschrittsbalken-Breite
    fill_width = bar_width * progress;
    bar.fill_sprite.SetX(bar.x);
    bar.fill_sprite.SetY(bar.y);
};

bar.bg_image = Image.Text("", 0.85, 0.85, 0.85);
bar.bg_sprite = Sprite();
bar.bg_sprite.SetPosition(bar.x, bar.y, 10);

bar.fill_image = Image.Text("", 0.18, 0.55, 0.34);
bar.fill_sprite = Sprite();
bar.fill_sprite.SetPosition(bar.x, bar.y, 11);

Plymouth.SetBootProgressFunction(fun_progress_callback);

fun_refresh_callback = function() {
};
Plymouth.SetRefreshFunction(fun_refresh_callback);

fun_display_password_callback = function(prompt, bullets) {
    // Falls Festplattenverschlüsselung o.ä. ein Passwort braucht:
    // einfacher Text-Prompt, damit das Theme nicht abstürzt
    if (prompt) {
        message_sprite = Sprite(Image.Text(prompt, 1, 1, 1));
        message_sprite.SetPosition(screen_width / 2 - 100, screen_height / 2 + 100, 10000);
    }
};
Plymouth.SetDisplayPasswordFunction(fun_display_password_callback);
